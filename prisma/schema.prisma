generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model brukere {
  id           Int      @id @default(autoincrement())
  navn         String
  rolle        String   @default("spiller")
  tlf          String?  @unique
  epost        String   @unique
  passord_hash String
  spiller_id   Int
  spillere     spillere @relation(fields: [spiller_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "spiller_bruker")
}

model kamp_oppstillinger {
  id                                         Int                     @id @default(autoincrement())
  created_at                                 DateTime?               @default(now()) @db.Timestamp(6)
  lag_id                                     Int?
  lag                                        lag?                    @relation(fields: [lag_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "lag_oppstilling")
  kamper_kamper_lag_1_idTokamp_oppstillinger kamper[]                @relation("kamper_lag_1_idTokamp_oppstillinger")
  kamper_kamper_lag_2_idTokamp_oppstillinger kamper[]                @relation("kamper_lag_2_idTokamp_oppstillinger")
  spiller_oppstillinger                      spiller_oppstillinger[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model kamper {
  id                                                     Int                @id @default(autoincrement())
  tid                                                    DateTime           @unique @db.Timestamp(6)
  omgang_id                                              Int?
  lag_1_id                                               Int
  lag_2_id                                               Int
  kamp_oppstillinger_kamper_lag_1_idTokamp_oppstillinger kamp_oppstillinger @relation("kamper_lag_1_idTokamp_oppstillinger", fields: [lag_1_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "kamp_lag_1")
  kamp_oppstillinger_kamper_lag_2_idTokamp_oppstillinger kamp_oppstillinger @relation("kamper_lag_2_idTokamp_oppstillinger", fields: [lag_2_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "kamp_lag_2")
  omganger                                               omganger?          @relation(fields: [omgang_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "kamp_omgang")
  maal                                                   maal[]
}

model lag {
  id                 Int                  @id @default(autoincrement())
  navn               String
  klasse             String
  kamp_oppstillinger kamp_oppstillinger[]
  spillere           spillere[]
}

model maal {
  id         Int       @id @default(autoincrement())
  video      String?
  kamp_id    Int?
  spiller_id Int?
  kamper     kamper?   @relation(fields: [kamp_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "maal_kamp")
  spillere   spillere? @relation(fields: [spiller_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "maal_spiller")
}

model omganger {
  id        Int      @id @default(autoincrement())
  omgang_nr Int      @unique
  tid       DateTime @unique @db.Timestamp(6)
  kamper    kamper[]
}

model spiller_oppstillinger {
  id                 Int                @id @default(autoincrement())
  spillepris         Int
  oppstilling_id     Int
  spiller_id         Int
  kamp_oppstillinger kamp_oppstillinger @relation(fields: [oppstilling_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "oppstilling_spiller")
  spillere           spillere           @relation(fields: [spiller_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "spiller_oppstilling")

  @@unique([oppstilling_id, spiller_id], map: "unique_spiller_per_oppstilling")
}

model spiller_priser {
  id         Int       @id @default(autoincrement())
  pris       Int
  created_at DateTime? @default(now()) @db.Timestamp(6)
  spiller_id Int
  spillere   spillere  @relation(fields: [spiller_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "spiller_pris")
}

model spillere {
  id                    Int                     @id @default(autoincrement())
  ganger_solgt          Int?                    @default(0)
  lag_id                Int?
  brukere               brukere[]
  maal                  maal[]
  spiller_oppstillinger spiller_oppstillinger[]
  spiller_priser        spiller_priser[]
  lag                   lag?                    @relation(fields: [lag_id], references: [id], onUpdate: NoAction, map: "spiller_lag")
}
